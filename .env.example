# Copy to .env. Generate the secrets, e.g. `openssl rand -hex 24`.
INFLUX_TOKEN=
INFLUX_PASSWORD=
GRAFANA_PASSWORD=

# Your time zone (the daily profile and quiet hours use it).
TZ=America/Denver
# The user that owns your ~/.claude and ~/.codex (`id -u`, `id -g`), so the container can write them.
HOST_UID=1000
HOST_GID=1000

# Optional
# QUIET_HOURS=1-7        # local hours with no pings (sampling continues)
# CLAUDE_MODEL=haiku
# CODEX=off              # skip Codex
# CODEX_MODEL=
# DRY_RUN=1              # log decisions, send no pings
# CLAUDE_DIR=~/.claude
# CODEX_DIR=~/.codex
